{
  "schema_version": "1.0.0",
  "environment": "local-lab",
  "listen_addr": "127.0.0.1:8443",
  "upstream_url": "http://127.0.0.1:18080",
  "upstream_timeout_ms": 500,
  "deny_by_default": true,
  "require_mtls": true,
  "require_cert_bound_token": true,
  "oidc": {
    "issuer": "https://oidc.finsec.local",
    "audience": "https://api.finsec.local/gateway",
    "allowed_algorithms": ["EdDSA", "ES256"],
    "max_clock_skew_seconds": 30
  },
  "signing": {
    "required": true,
    "max_request_age_seconds": 60,
    "max_future_skew_seconds": 15,
    "nonce_ttl_seconds": 300,
    "max_nonce_entries": 10000,
    "allowed_algorithms": ["Ed25519", "HMAC-SHA256"]
  },
  "rate_limit": {
    "default_requests_per_second": 20,
    "default_burst": 40
  },
  "audit": {
    "redact_headers": [
      "authorization",
      "x-signature",
      "x-api-key",
      "cookie",
      "set-cookie",
      "proxy-authorization"
    ],
    "redact_json_keys": [
      "secret",
      "token",
      "access_token",
      "refresh_token",
      "password",
      "private_key",
      "api_key",
      "client_secret",
      "signature"
    ],
    "max_body_bytes": 65536
  }
}
